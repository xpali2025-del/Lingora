# Copy to the hosting provider's environment settings. Never commit real values.
# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, or self-hosted).
DATABASE_URL=postgres://user:password@host:5432/lingora
# Dashboard access token: at least 24 random characters, e.g. `openssl rand -hex 24`.
LINGORA_ADMIN_TOKEN=
# 32-byte key, base64, that encrypts codes at rest: `openssl rand -base64 32`. Losing it makes stored codes unreadable.
LINGORA_CODES_KEY=
# Complete USDT (BEP20) receiving address. Leave empty to keep crypto checkout disabled.
LINGORA_BEP20_ADDRESS=
# Optional: BNB Smart Chain JSON-RPC endpoint and required confirmations.
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
BSC_MIN_CONFIRMATIONS=15
